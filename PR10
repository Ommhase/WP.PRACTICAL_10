<?php
// Save as practical10.php in C:\xampp\htdocs\webprac
$conn = new mysqli('localhost', 'root', '', 'TechnologyPortal');
if ($conn->connect_error) {
    die('Database connection failed. Check XAMPP/MySQL settings.');
}
$conn->set_charset('utf8mb4');

$message = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';

    // INSERT
    if ($action === 'insert') {
        $name = trim($_POST['name'] ?? '');
        $category = trim($_POST['category'] ?? '');
        $description = trim($_POST['description'] ?? '');

        if ($name !== '' && $category !== '') {
            $stmt = $conn->prepare('INSERT INTO technologies (name, category, description) VALUES (?, ?, ?)');
            $stmt->bind_param('sss', $name, $category, $description);
            $message = $stmt->execute() ? 'Record inserted.' : 'Insert failed.';
            $stmt->close();
        } else {
            $message = 'Name and category are required.';
        }
    } 
    // UPDATE
    elseif ($action === 'update') {
        $id = filter_input(INPUT_POST, 'id', FILTER_VALIDATE_INT);
        $name = trim($_POST['name'] ?? '');
        $category = trim($_POST['category'] ?? '');
        $description = trim($_POST['description'] ?? '');

        if ($id && $name !== '' && $category !== '') {
            $stmt = $conn->prepare('UPDATE technologies SET name=?, category=?, description=? WHERE id=?');
            $stmt->bind_param('sssi', $name, $category, $description, $id);
            $message = $stmt->execute() ? 'Update completed.' : 'Update failed.';
            $stmt->close();
        } else {
            $message = 'Enter a valid ID, name and category.';
        }
    } 
    // DELETE
    elseif ($action === 'delete') {
        $id = filter_input(INPUT_POST, 'id', FILTER_VALIDATE_INT);

        if ($id) {
            $stmt = $conn->prepare('DELETE FROM technologies WHERE id=?');
            $stmt->bind_param('i', $id);
            $message = $stmt->execute() ? 'Delete request completed.' : 'Delete failed.';
            $stmt->close();
        } else {
            $message = 'Enter a valid ID to delete.';
        }
    }
}
